FROM python:3.11-slim

WORKDIR /app
COPY deploy/lab/context-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY inference/context_service.py /app/context_service.py
COPY config/r3-taxonomy.json /opt/ghl/config/r3-taxonomy.json

ENV PYTHONUNBUFFERED=1 \
    CROP_CONTEXT_TAXONOMY_PATH=/opt/ghl/config/r3-taxonomy.json \
    CROP_CONTEXT_MODEL_PATH=/models/context/openai-clip-vit-base-patch32 \
    CROP_CONTEXT_THREADS=8

EXPOSE 8891
CMD ["uvicorn", "context_service:app", "--host", "0.0.0.0", "--port", "8891"]
