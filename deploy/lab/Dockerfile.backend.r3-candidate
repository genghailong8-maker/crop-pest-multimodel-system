FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/ghl/backend
WORKDIR /opt/ghl/backend
COPY cache/wheels/backend /wheels
COPY deploy/lab/backend-requirements.r3-candidate.txt /tmp/requirements.txt
RUN python -m pip install --no-index --find-links=/wheels -r /tmp/requirements.txt && rm -rf /wheels
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY knowledge /opt/ghl/knowledge
COPY docs/competition /opt/ghl/docs/competition
COPY config/r3-taxonomy.json /opt/ghl/config/r3-taxonomy.json
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
