FROM node:22-bookworm-slim

WORKDIR /opt/ghl/web
ARG CROP_API_ORIGIN
ARG CROP_ORIGIN_SECRET
ENV CROP_API_ORIGIN=${CROP_API_ORIGIN} CROP_ORIGIN_SECRET=${CROP_ORIGIN_SECRET}
COPY cache/npm /npm-cache
COPY web/package.json web/package-lock.json ./
RUN npm ci --offline --cache /npm-cache --no-audit --no-fund
COPY web ./
RUN npm run build
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
