FROM public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/ghl
COPY cache/wheels/inference /wheels
COPY app/deploy/lab/offline/inference-requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-index --find-links=/wheels -r /tmp/requirements.txt \
    && rm -rf /wheels
COPY app/inference ./inference
CMD ["python", "-m", "uvicorn", "inference.service:app", "--host", "0.0.0.0", "--port", "8870"]
