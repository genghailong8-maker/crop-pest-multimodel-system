[Unit]
Description=Bridge Docker backend to the Windows-managed GPU SSH tunnel
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/root/anaconda3/bin/python /data/ghl/app/deploy/lab/tcp_relay.py --listen-host 172.17.0.1 --listen-port 18000 --target-host 127.0.0.1 --target-port 18000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
