FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/ghl
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY inference/requirements.txt ./inference/requirements.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision \
    && python -m pip install --no-cache-dir -r inference/requirements.txt
COPY inference ./inference
CMD ["python", "-m", "uvicorn", "inference.service:app", "--host", "0.0.0.0", "--port", "8870"]
