FROM public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/ghl/backend
COPY cache/wheels/backend /wheels
COPY app/deploy/lab/offline/backend-requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-index --find-links=/wheels -r /tmp/requirements.txt \
    && rm -rf /wheels
COPY app/backend/app ./app
COPY app/backend/scripts ./scripts
COPY app/knowledge /opt/ghl/knowledge
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
