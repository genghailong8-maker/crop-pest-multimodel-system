CROP_API_HOST=127.0.0.1
CROP_API_PORT=8000
CROP_STORAGE_DIR=runtime
CROP_INSTANCE_ID=lab_cpu
CROP_INSTANCE_LABEL=实验室 CPU
CROP_GATEWAY_MODE=false
CROP_CONTROL_DIR=runtime/control
# 实验室网关通过 SSH 隧道访问原 GPU 服务器后端，例如 http://host.docker.internal:18000。
CROP_REMOTE_INSTANCE_ID=gpu_full
CROP_REMOTE_INSTANCE_LABEL=原 GPU 服务器
CROP_REMOTE_BACKEND_URL=
CROP_REMOTE_BACKEND_TIMEOUT_SECONDS=300
# 使用 backend/scripts/generate_admin_secrets.py 生成，禁止填写明文密码。
CROP_ADMIN_PASSWORD_HASH=
CROP_ADMIN_SESSION_SECRET=
CROP_ADMIN_SESSION_TTL_SECONDS=3600
CROP_ADMIN_COOKIE_SECURE=false
CROP_MODEL_PATH=
CROP_MODEL_DEVICE=cpu
CROP_MODEL_CONFIDENCE=0.25
# 正式架构优先使用服务器视觉服务；配置后会覆盖本地权重方式。
# inference/open_tunnel.ps1 建立 SSH 私有隧道后使用下列地址。
CROP_DETECTOR_ENDPOINT=http://127.0.0.1:8870/v1/detect
CROP_DETECTOR_API_KEY=
# 服务器推理默认 shadow：专家只记录路由证据，不改变主模型结果。
# 第二轮独立校准未通过 frozen 门；仅在单独验证后临时改为 active。
# CROP_INFERENCE_ROUTING_MODE=shadow
# CROP_INFERENCE_THRESHOLD10=0.15
# CROP_INFERENCE_THRESHOLD13=0.15
# CROP_INFERENCE_BACKGROUND_THRESHOLD=0.90
# CROP_INFERENCE_TEMPERATURE10=1.25
# CROP_INFERENCE_TEMPERATURE13=0.75
CROP_DETECTOR_TIMEOUT_SECONDS=30
CROP_VLM_ENDPOINT=
CROP_VLM_API_KEY=
CROP_VLM_MODEL=crop-pest-vlm
CROP_VLM_TIMEOUT_SECONDS=120
CROP_VLM_MAX_CONCURRENCY=1
CROP_PRELABEL_DIR=../artifacts/dataset-audit/pest65-aphids/prelabels
CROP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 公网模式仅在 Sites Worker 代理已配置后启用。密钥只存放于 Worker/主机环境变量。
CROP_PUBLIC_MODE=false
CROP_PUBLIC_ORIGIN_SECRET=
CROP_PUBLIC_RETENTION_DAYS=30
CROP_PUBLIC_UPLOADS_PER_HOUR=10
CROP_PUBLIC_ANALYSES_PER_HOUR=20
